{
  "name": "tutto-a-lena-cms",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "npm run lint:cms && npm run lint:functions",
    "lint:cms": "eslint . --cache --max-warnings=0",
    "lint:functions": "npm --prefix functions run lint",
    "lint:fix": "npm run lint:fix:cms && npm run lint:fix:functions",
    "lint:fix:cms": "eslint . --fix",
    "lint:fix:functions": "npm --prefix functions run lint -- --fix",
    "format": "npm run format:cms && npm run format:functions",
    "format:cms": "prettier --write .",
    "format:functions": "prettier --write \"functions/src/**/*.ts\" \"functions/.eslintrc.js\"",
    "check": "npm run lint && npm run typecheck && npm run format",
    "precommit": "npm run check",
    "test": "ng test",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.12.0",
  "dependencies": {
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.5",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "firebase": "^12.11.0",
    "rxjs": "~7.8.0",
    "tailwind-animations": "^1.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "^21.3.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
